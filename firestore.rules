rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null;
      // Mỗi document users chỉ có đúng bốn trường theo yêu cầu đề bài.
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['email', 'matkhau', 'hoten', 'hinhanh'])
        && request.resource.data.keys().hasOnly(['email', 'matkhau', 'hoten', 'hinhanh']);
    }
  }
}
