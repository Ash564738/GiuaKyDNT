rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collectionId}/{giangVienId} {
      allow read, delete: if request.auth != null
        && collectionId == 'Giang Vien';
      // Mỗi document Giang Vien chỉ có đúng bốn trường theo đề bài.
      allow create, update: if request.auth != null
        && collectionId == 'Giang Vien'
        && request.resource.data.keys().hasAll(['IDGV', 'Fullname', 'Image', 'SumClass'])
        && request.resource.data.keys().hasOnly(['IDGV', 'Fullname', 'Image', 'SumClass'])
        && request.resource.data.IDGV is string
        && request.resource.data.Fullname is string
        && request.resource.data.Image is string
        && request.resource.data.SumClass is int
        && request.resource.data.SumClass >= 0;
    }
  }
}
